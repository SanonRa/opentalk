#
# OpenTalk Environment Configuration Example
# Copy this file to `.env` before running `docker compose up --build` if you want
# to enable cloud speech-to-text streaming.
#
# IMPORTANT:
# - OpenTalk starts and renders its full UI even if ALL API keys below are empty.
# - Never commit `.env` with real API keys to version control.
# - API keys are read ONLY by the Node.js backend (`server/`). They are never
#   embedded into the client-side browser bundle.

# ==============================================================================
# Server & Networking
# ==============================================================================
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:8080

# Frontend public port exposed by Docker Compose
OPENTALK_WEB_PORT=8080
# Backend port exposed by Docker Compose (optional direct access)
OPENTALK_API_PORT=4000

# ==============================================================================
# Cloud ASR Provider Selection
# ==============================================================================
# Supported values:
#   auto     - Uses Sarvam AI if SARVAM_API_KEY is set, else Deepgram if DEEPGRAM_API_KEY is set
#   sarvam   - Force Sarvam AI real-time streaming STT (optimised for Indian languages + en-IN)
#   deepgram - Force Deepgram streaming STT (Nova-3 / Nova-2)
ASR_DEFAULT_PROVIDER=auto

# ==============================================================================
# Provider 1: Sarvam AI (Recommended for Indian English & Hindi / Hinglish)
# Docs: https://docs.sarvam.ai/api/api-guides-tutorials/speech-to-text/streaming-api
# ==============================================================================
SARVAM_API_KEY=
# Model options: saaras:v4 (default) or saaras:v3-realtime
SARVAM_STT_MODEL=saaras:v4
# Mode options: transcribe, translate, verbatim, translit, codemix
SARVAM_STT_MODE=transcribe

# ==============================================================================
# Provider 2: Deepgram (Low-latency global streaming STT, en-IN & Hindi)
# Docs: https://developers.deepgram.com/docs/models-languages-overview
# ==============================================================================
DEEPGRAM_API_KEY=
# Model options: nova-3 (recommended) or nova-2
DEEPGRAM_STT_MODEL=nova-3
# Endpointing silence window in milliseconds before finalizing an utterance
DEEPGRAM_ENDPOINTING_MS=400

# ==============================================================================
# Optional WebSocket & Session Safety Limits
# ==============================================================================
# Maximum duration of a single streaming session in seconds (default: 1800 = 30 min)
ASR_MAX_SESSION_SECONDS=1800
# Heartbeat interval in milliseconds
WS_HEARTBEAT_MS=25000
# Optional shared token required for /ws/transcribe connections (recommended if exposed publicly)
WS_AUTH_TOKEN=
# Maximum total concurrent WebSocket transcription sessions
MAX_CONCURRENT_SESSIONS=10
# Maximum concurrent WebSocket transcription sessions per client IP
MAX_SESSIONS_PER_IP=3
# Set true when running behind a trusted reverse proxy (e.g. Docker Nginx) so X-Real-IP / X-Forwarded-For are honoured
TRUST_PROXY=false
# Reject WebSocket connections missing an Origin header by default (set true only for non-browser test clients)
WS_ALLOW_NO_ORIGIN=false
